{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Jarvis: 开发运行",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Jarvis: 完整检查",
      "type": "npm",
      "script": "check",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": ["$tsc", "$rustc"]
    },
    {
      "label": "Jarvis: 构建 Windows NSIS",
      "type": "npm",
      "script": "build:windows",
      "group": "build",
      "problemMatcher": ["$tsc", "$rustc"],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
